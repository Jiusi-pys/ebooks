<Window x:Class="Shufang.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="书房">
 <NavigationView x:Name="Navigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" ItemInvoked="Navigate">
  <NavigationView.MenuItems>
   <NavigationViewItem Content="书库" Tag="books" Icon="Library" IsSelected="True" />
   <NavigationViewItem Content="笔记" Tag="notes" Icon="Edit" />
   <NavigationViewItem Content="书摘" Tag="highlights" Icon="Highlight" />
   <NavigationViewItem Content="关联图谱" Tag="associations" Icon="Link" />
   <NavigationViewItem Content="脑图" Tag="mindMaps" Icon="Map" />
   <NavigationViewItem Content="学习集" Tag="studySets" Icon="Bookmarks" />
   <NavigationViewItem Content="复习" Tag="review" Icon="Clock" />
   <NavigationViewItem Content="阅读历史" Tag="history" Icon="Calendar" />
   <NavigationViewItem Content="文件夹" Tag="folders" Icon="Folder" />
   <NavigationViewItem Content="译文" Tag="translations" Icon="World" />
  </NavigationView.MenuItems>
  <Grid Padding="20" RowSpacing="12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock x:Name="Heading" Text="书库" FontSize="28" FontWeight="SemiBold" />
   <ScrollViewer x:Name="TopActions" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Orientation="Horizontal" Spacing="8">
    <Button Content="导入" AutomationProperties.AutomationId="Import" Click="ImportBooks"/>
    <Button Content="路径导入" Click="ImportPath"/>
    <Button Content="刷新" Click="RefreshList"/>
    <Button Content="新建" AutomationProperties.AutomationId="New" Click="NewItem"/>
    <Button Content="保存" AutomationProperties.AutomationId="Save" Click="SaveItem" IsEnabled="{x:Bind ViewModel.Ready, Mode=OneWay}"/>
    <Button Content="删除" Click="DeleteItem"/>
    <Button Content="阅读 / 跳回" Click="OpenReader"/>
    <Button Content="AI 助手" Click="ShowAi"/>
    <Button Content="取消任务" Click="CancelTask"/>
   </StackPanel></ScrollViewer>
   <Grid Grid.Row="2" ColumnSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <AutoSuggestBox PlaceholderText="搜索当前列表" QueryIcon="Find" QuerySubmitted="Search" AutomationProperties.AutomationId="Search"/>
     <ListView x:Name="Entries" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items}" DisplayMemberPath="Title" SelectionChanged="SelectItem" AutomationProperties.AutomationId="Entries"/>
    </Grid>
    <Grid Grid.Column="1">
     <ScrollViewer x:Name="Editor"><StackPanel Spacing="12">
      <TextBox x:Name="TitleInput" Header="标题 / 名称" AutomationProperties.AutomationId="Title"/>
      <ComboBox x:Name="CitationSources" Header="引用来源（选择后点击阅读 / 跳回）" DisplayMemberPath="Title" Visibility="Collapsed"/>
      <TextBox x:Name="AuthorInput" Header="作者" Visibility="Collapsed"/>
      <StackPanel x:Name="BookMetadataPanel" Visibility="Collapsed" Spacing="8">
       <Button Content="自动查找元数据" Click="LookupMetadata"/>
       <Image x:Name="CoverImage" Height="180" HorizontalAlignment="Left"/>
       <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="设置封面" Click="SetCover"/><Button Content="清除自定义封面" Click="ClearCover"/></StackPanel>
       <TextBox x:Name="PublisherInput" Header="出版社"/><TextBox x:Name="PublishedDateInput" Header="出版日期"/><TextBox x:Name="IsbnInput" Header="ISBN"/>
       <TextBox x:Name="LanguageInput" Header="语言"/><TextBox x:Name="SeriesInput" Header="丛书"/><TextBox x:Name="SubjectsInput" Header="主题（逗号分隔）"/>
       <NumberBox x:Name="RatingInput" Header="评分" Minimum="0" Maximum="5" Value="0"/>
      </StackPanel>
      <TextBox x:Name="ContentInput" Header="内容" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="240" AutomationProperties.AutomationId="Content"/>
      <Button x:Name="PreviewNoteButton" Content="预览 / 编辑笔记" Click="PreviewNote" Visibility="Collapsed"/>
      <RichTextBlock x:Name="NotePreview" Visibility="Collapsed" IsTextSelectionEnabled="True" FontSize="17" TextWrapping="Wrap"/>
      <ComboBox x:Name="FolderInput" Header="所属文件夹" DisplayMemberPath="Title" Visibility="Collapsed"/>
      <TextBox x:Name="TagsInput" Header="标签（用逗号分隔）" Visibility="Collapsed"/>
      <TextBox x:Name="ClozeInput" Header="挖空词（用逗号分隔）" Visibility="Collapsed"/>
      <ListView x:Name="StudyBooks" SelectionMode="Multiple" DisplayMemberPath="Title" MaxHeight="300" Visibility="Collapsed"/>
      <Button x:Name="StudyReviewButton" Content="复习此学习集" Click="ReviewStudySet" Visibility="Collapsed"/>
      <Button x:Name="EnrollReviewButton" Content="加入 / 退出复习" Click="ToggleReview" Visibility="Collapsed"/>
      <StackPanel x:Name="ReviewQuestion" Visibility="Collapsed" Spacing="8"><TextBlock x:Name="ReviewPrompt" TextWrapping="Wrap" FontSize="22"/><Button Content="显示答案" Click="RevealReview"/></StackPanel>
      <StackPanel x:Name="ReviewControls" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
       <Button Content="重复" Tag="1" Click="Rate"/><Button Content="难" Tag="2" Click="Rate"/><Button Content="中" Tag="3" Click="Rate"/><Button Content="易" Tag="4" Click="Rate"/>
      </StackPanel>
      <StackPanel x:Name="MindControls" Visibility="Collapsed" Spacing="8">
       <TreeView x:Name="MindTree" ItemInvoked="SelectMindNode"/>
       <TextBox x:Name="MindNodeText" Header="节点文字"/>
       <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="修改节点" Click="UpdateMindNode"/><Button Content="添加子节点" Click="AddMindNode"/><Button Content="删除节点" Click="DeleteMindNode"/></StackPanel>
      </StackPanel>
     </StackPanel></ScrollViewer>
     <Grid x:Name="ReaderPanel" Visibility="Collapsed" RowSpacing="8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="返回编辑" Click="CloseReader"/><Button Content="保存划线" Click="HighlightSelection"/><Button Content="引用到笔记" Click="CiteSelection"/><Button Content="记住关联起点" Click="PinAssociation"/><Button Content="关联到此处" Click="CreateAssociation"/></StackPanel>
      <WebView2 x:Name="Reader" Grid.Row="1"/>
     </Grid>
     <ScrollViewer x:Name="GraphPanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto"><Canvas x:Name="GraphCanvas" Width="900" Height="700"/></ScrollViewer>
     <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed"><StackPanel Spacing="12" MaxWidth="700" HorizontalAlignment="Left">
      <TextBlock Text="AI 设置" FontSize="22"/><ComboBox x:Name="ProviderInput" Header="服务商" SelectedIndex="1"><x:String>openai</x:String><x:String>deepseek</x:String><x:String>kimi</x:String><x:String>minimax</x:String><x:String>codex</x:String></ComboBox>
      <TextBlock Text="软件更新" FontSize="22"/><TextBox x:Name="UpdateFeedInput" Header="签名更新清单地址 (HTTPS)"/><TextBox x:Name="UpdateKeyInput" Header="可信发布公钥 (RSA PEM)" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160"/>
      <Button Content="保存更新源与公钥" Click="SaveUpdateSettings"/>
      <CheckBox x:Name="AutomaticUpdateCheck" Content="启动时检查签名更新清单（需要联网，保存后生效）"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="检查更新" Click="CheckUpdate"/><Button x:Name="DownloadUpdateButton" Content="下载并校验" Click="DownloadUpdate" IsEnabled="False"/><Button x:Name="InstallUpdateButton" Content="关闭并更新" Click="InstallUpdate" IsEnabled="False"/></StackPanel>
      <TextBlock x:Name="UpdateStatus" Text="配置可信更新源后手动检查。程序和数据备份分别保留。" TextWrapping="Wrap"/>
      <TextBox x:Name="ModelInput" Header="模型"/><ComboBox x:Name="EffortInput" Header="思考强度" SelectedIndex="0"><x:String>none</x:String><x:String>low</x:String><x:String>medium</x:String><x:String>high</x:String><x:String>xhigh</x:String><x:String>max</x:String></ComboBox>
      <PasswordBox x:Name="ApiKeyInput" Header="API Key（留空保留已有密钥）"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="保存 AI 设置" Click="SaveAiSettings"/><Button Content="连接测试" Click="TestAi"/><Button Content="读取模型列表" Click="ListModels"/></StackPanel>
      <TextBlock x:Name="ModelsResult" TextWrapping="Wrap"/>
      <TextBlock Text="跨节点同步" FontSize="22"/>
      <TextBlock x:Name="SyncIdentity" TextWrapping="Wrap"/>
      <ListView x:Name="SyncPeers" DisplayMemberPath="Title" MaxHeight="180" SelectionChanged="SelectSyncPeer"/>
      <TextBox x:Name="SyncPeerId" Header="远端节点 ID"/>
      <TextBox x:Name="SyncPeerUrl" Header="远端服务地址 (HTTPS)"/>
      <PasswordBox x:Name="SyncPeerToken" Header="配对令牌（留空保留已有令牌）"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="保存节点" Click="SaveSyncPeer"/><Button Content="移除所选节点" Click="RemoveSyncPeer"/></StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="开始同步" Click="ResumeSync"/><Button Content="暂停同步" Click="PauseSync"/><Button Content="立即同步" Click="RequestSync"/><Button Content="刷新同步状态" Click="RefreshSync"/></StackPanel>
      <TextBlock x:Name="SyncStatus" Text="默认暂停。开始同步会启动本地服务，并将工作区数据发送到配置的节点。" TextWrapping="Wrap"/>
      <TextBlock Text="独立服务" FontSize="22"/><NumberBox x:Name="ServicePort" Header="本地端口" Value="31417" Minimum="1024" Maximum="65535"/>
      <Button Content="保存端口 / 刷新状态" Click="SaveServicePort"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="启动服务" Click="StartService"/><Button Content="停止服务" Click="StopService"/></StackPanel>
      <CheckBox x:Name="ServiceAutoStart" Content="登录 Windows 时启动服务" Click="ChangeAutoStart"/>
      <Button Content="复制服务访问令牌" Click="CopyServiceToken"/>
      <TextBlock x:Name="ServiceStatus" Text="默认关闭。关闭窗口不会停止已启动的服务。" TextWrapping="Wrap"/>
      <TextBlock Text="Webhook 订阅" FontSize="22"/>
      <TextBox x:Name="WebhookUrl" Header="接收地址 (HTTP / HTTPS)"/><TextBox x:Name="WebhookEvents" Header="事件（逗号分隔，* 表示全部）" Text="*"/><PasswordBox x:Name="WebhookSecret" Header="签名密钥"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="添加订阅" Click="AddWebhook"/><Button Content="刷新订阅与投递" Click="RefreshWebhooks"/></StackPanel>
      <ListView x:Name="Webhooks" DisplayMemberPath="Title" MaxHeight="180"/><Button Content="删除所选订阅" Click="DeleteWebhook"/>
      <ListView x:Name="WebhookDeliveries" DisplayMemberPath="Title" MaxHeight="180"/><Button Content="重试所选投递" Click="RetryWebhook"/>
      <TextBlock Text="备份与恢复" FontSize="22"/>
      <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="备份工作区" Click="BackupWorkspace"/><Button Content="恢复到新工作区" Click="RestoreWorkspace"/></StackPanel>
      <TextBlock Text="恢复会创建新目录。密钥备份只能由原 Windows 用户解密。" TextWrapping="Wrap"/>
     </StackPanel></ScrollViewer>
     <ScrollViewer x:Name="AiPanel" Visibility="Collapsed"><StackPanel Spacing="12">
      <Button Content="返回" Click="CloseAi"/><ComboBox x:Name="AiTask" Header="任务" SelectedIndex="0"><ComboBoxItem Content="阅读问答" Tag="chat"/><ComboBoxItem Content="翻译" Tag="translate"/><ComboBoxItem Content="全书导读" Tag="digest"/><ComboBoxItem Content="生成脑图" Tag="mindmap"/><ComboBoxItem Content="生成学习卡片" Tag="studyCard"/></ComboBox>
      <TextBox x:Name="AiContext" Header="本次发送的文段" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="220"/>
      <TextBlock Text="全书导读会将当前书籍的全部可提取正文分段发送给所选 AI 服务商，可随时取消。" TextWrapping="Wrap"/>
      <TextBox x:Name="AiQuestion" Header="问题 / 要求"/><Button Content="发送" Click="RunAi"/>
      <TextBox x:Name="AiAnswer" Header="回答" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="250"/>
      <Button Content="保存为笔记" Click="SaveAiNote"/>
      <Button Content="保存生成的脑图 / 卡片 / 翻译" Click="SaveAiGenerated"/>
     </StackPanel></ScrollViewer>
    </Grid>
   </Grid>
   <StackPanel Grid.Row="3"><TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="Status"/><TextBlock x:Name="UpdateNotice" TextWrapping="Wrap"/></StackPanel>
  </Grid>
 </NavigationView>
</Window>
