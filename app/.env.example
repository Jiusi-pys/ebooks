# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # One-time bootstrap login name; used only before first account setup
APP_SECRET=               # One-time bootstrap password; may be rotated/removed after key migration
APP_DATA_SECRET=          # >=32-byte username-encryption key; production deployments should set this
APP_SESSION_SECRET=       # Optional >=32-byte session key; blank creates .runtime/session-secret
HOST=127.0.0.1            # Keep loopback unless TLS and network controls are configured
PORT=3000                  # HTTP port used by the production server
PUBLIC_ORIGIN=             # Browser origin behind TLS proxy, e.g. https://books.example.com
SESSION_TTL_SECONDS=43200 # 5 minutes to 7 days; default is 12 hours
SESSION_COOKIE_SECURE=false # Set true when serving through HTTPS
OPEN_API_KEY=             # Separate key for Hermes/OpenClaw machine requests; blank disables the machine API
MCP_API_KEY=              # Separate key for the remote /mcp endpoint; blank disables remote MCP
MCP_API_BASE_URL=         # Optional base URL for local MCP stdio; defaults to http://127.0.0.1:$PORT

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Codex CLI（复用本机 codex login 的 ChatGPT 登录态）─────────
CODEX_BIN=codex
CODEX_MODEL=gpt-5.6-terra
CODEX_REASONING_EFFORT=medium
CODEX_TIMEOUT_MS=180000
CODEX_LOGIN_TIMEOUT_MS=300000

# ── DeepSeek API（也可只在前端 AI 设置中按会话填写）────────────
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_MS=180000

# ── Daily GitHub updater (local Git checkout + process supervisor) ──
AUTO_UPDATE_ENABLED=false
AUTO_UPDATE_GITHUB_URL=
AUTO_UPDATE_BRANCH=main
AUTO_UPDATE_TIME=03:00
AUTO_UPDATE_RESTART_SUPERVISED=false

# Independent-node workspace replication; keep IDs stable and unique per DB.
SYNC_ENABLED=false
SYNC_WORKSPACE_ID=
SYNC_NODE_ID=
SYNC_BLOB_DIR=.runtime/blobs
# [{"id":"peer-node","url":"https://peer.example","token":"peer-issued-token"}]
SYNC_PEERS_JSON=[]
