  "components": {
    "securitySchemes": {
      "BrowserSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "shufang_session"
      },
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "NodeToken": {
        "type": "http",
        "scheme": "bearer"
      },
      "Workspace": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Workspace-Id"
      }
    },
    "schemas": {
      "Operation": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[\\w.:-]+$"
          },
          "operationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[\\w.:-]+$"
          },
          "replicaId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[\\w.:-]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "books",
              "folders",
              "notes",
              "highlights",
              "associations",
              "translations",
              "mindMaps",
              "studySets",
              "reviews",
              "preferences",
              "sources"
            ]
          },
          "entityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[\\w.:-]+$"
          },
          "clock": {
            "type": "string",
            "pattern": "^\\d{1,16}:\\d{1,10}$"
          },
          "patch": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "unset": {
            "default": [],
            "maxItems": 256,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "deleted": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "workspaceId",
          "operationId",
          "replicaId",
          "kind",
          "entityId",
          "clock",
          "patch",
          "unset",
          "deleted"
        ],
        "additionalProperties": false,
        "$defs": {
          "__schema0": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            ]
          }
        }
      },
      "Receipt": {
        "type": "object",
        "properties": {
          "operationId": {
            "type": "string"
          },
          "seq": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "duplicate": {
